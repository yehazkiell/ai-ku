# AI-KU WhatsApp (Baileys) bridge configuration

# Where the AI-KU REST API is running.
AIKU_API_URL=http://localhost:5000
# Must match AIKU_API_KEY of the AI-KU server.
AIKU_API_KEY=aiku_master_key_123

# In group chats, only reply to messages starting with this prefix.
# Set to empty to reply to every group message. Private chats always get a reply.
AIKU_WA_GROUP_PREFIX=.ai

# Folder where the WhatsApp login session is stored (keep it private).
AIKU_WA_AUTH_DIR=./auth_state
