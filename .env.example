# ===== AI-KU Configuration =====
# Copy this file to `.env` and adjust the values.

# --- Core ---
# Master key required in the X-API-KEY header for every API request.
AIKU_API_KEY=your_master_key_here
# development | production  (production enforces stricter warnings)
AIKU_ENV=development

# --- LLM Providers (optional but recommended for stability) ---
# If all are empty, AI-KU falls back to free g4f providers.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- LLM Routing ---
# auto | openrouter | groq | openai | g4f
AIKU_LLM_PROVIDER=auto
AIKU_LLM_MODEL=gpt-4o-mini
AIKU_REQUEST_TIMEOUT=60

# --- Autonomous Agent ---
AIKU_MAX_ITERATIONS=6
AIKU_ENABLE_REFLECTION=true

# --- Memory / RAG ---
AIKU_MEMORY_PATH=./chroma_db
AIKU_MEMORY_TOP_K=4

# --- Server ---
AIKU_HOST=0.0.0.0
AIKU_PORT=5000
