# ===== AI-KU Configuration =====
# Copy this file to `.env` and adjust the values.

# --- Core ---
# Master key required in the X-API-KEY header for every API request.
AIKU_API_KEY=your_master_key_here
# development | production  (production enforces stricter warnings)
AIKU_ENV=development

# --- LLM Providers (optional but recommended for stability) ---
# If all are empty, AI-KU falls back to free g4f providers.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Local / Own Model (no API key) ---
# Any OpenAI-compatible /v1 endpoint: Ollama, LocalAI, LM Studio, vLLM, jan,
# llama.cpp server, etc. This is the "bring your own model, no API key" path.
# Enable it (use it first in auto mode):
AIKU_USE_LOCAL=false
# Default points at Ollama's OpenAI-compatible endpoint.
AIKU_LOCAL_BASE_URL=http://localhost:11434/v1
AIKU_LOCAL_MODEL=llama3.2
# Most local servers ignore this; set only if your server requires a key.
AIKU_LOCAL_API_KEY=

# --- LLM Routing ---
# auto | local | ollama | openrouter | groq | openai | g4f
# (local/ollama = local-only, never falls back to the cloud)
AIKU_LLM_PROVIDER=auto
# Leave empty to use each provider's own default model
# (e.g. llama-3.3-70b-versatile for Groq). Set to override globally.
AIKU_LLM_MODEL=
AIKU_REQUEST_TIMEOUT=60

# --- Autonomous Agent ---
AIKU_MAX_ITERATIONS=6
AIKU_ENABLE_REFLECTION=true

# --- Memory / RAG ---
AIKU_MEMORY_PATH=./chroma_db
AIKU_MEMORY_TOP_K=4

# --- Server ---
AIKU_HOST=0.0.0.0
AIKU_PORT=5000

# --- Messaging Channels (all optional) ---
# Telegram: token from @BotFather. Run: python3 -m aiku.channels.telegram_bot
TELEGRAM_BOT_TOKEN=
# WhatsApp via Twilio: only needed if you want to validate request signatures.
TWILIO_AUTH_TOKEN=
# WhatsApp via Meta Cloud API (https://developers.facebook.com/ -> WhatsApp):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token you choose; must match the "Verify token" entered in the Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=aiku-verify
